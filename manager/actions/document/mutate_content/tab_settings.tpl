<!-- Settings -->
<div class="tab-page" id="tabSettings">
    <h2 class="tab" id="tabSettingsHeader">[+_lang_settings_page_settings+]</h2>
    <div class="mutate-section" data-field-group="publish">
        <h3 class="settings-section">[+_lang_group_publish+]</h3>
        <table class="mutate-fields">
            [+fieldPublished+]
            [+fieldPub_date+]
            [+fieldUnpub_date+]
        </table>
    </div>
    <div class="mutate-section" data-field-group="type">
        <h3 class="settings-section">[+_lang_group_type+]</h3>
        <table class="mutate-fields">
            [+fieldType+]
            [+fieldContentType+]
            [+fieldContent_dispo+]
            [+fieldIsfolder+]
        </table>
    </div>
    <div class="mutate-section" data-field-group="behavior">
        <h3 class="settings-section">[+_lang_group_behavior+]</h3>
        <table class="mutate-fields">
            [+fieldLink_attributes+]
            [+fieldRichtext+]
            [+fieldSearchable+]
            [+fieldCacheable+]
            [+fieldDonthit+]
            [+fieldSyncsite+]
        </table>
    </div>
    <table class="mutate-fields" data-moved-fields></table>
</div><!-- end #tabSettings -->
