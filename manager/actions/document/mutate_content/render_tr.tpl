<tr class="mutate-field-row" data-field="[+field+]" style="[+rowstyle+]">
    <td class="mutate-field-label">
        <span class="mutate-field-title" data-field-part="title">[+head+]</span>[+extra_head+]
    </td>
    <td data-field-part="value">
        <div class="field-inline">[+body+]</div>[+note+]
    </td>
</tr>
