<!-- General -->
<div class="tab-page" id="tabGeneral">
    <h2 class="tab" id="tabGeneralHeader">[+_lang_settings_general+]</h2>
    <table class="mutate-fields">
        [+fieldPagetitle+]
        [+fieldWeblink+]
    </table>
    <details class="mutate-group" data-field-group="basic">
        <summary>[+_lang_group_basic+]</summary>
        <table class="mutate-fields">
            [+fieldLongtitle+]
            [+fieldDescription+]
            [+fieldAlias+]
            [+fieldIntrotext+]
        </table>
    </details>
    <details class="mutate-group" data-field-group="menu">
        <summary>[+_lang_group_menu+]</summary>
        <table class="mutate-fields">
            [+fieldTemplate+]
            [+fieldMenutitle+]
            [+fieldMenuindex+]
            [+fieldParent+]
        </table>
    </details>
    [+sectionContent+]
    [+sectionTV+]
    <table class="mutate-fields" data-moved-fields></table>
</div><!-- end #tabGeneral -->
