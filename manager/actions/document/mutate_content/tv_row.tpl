<tr class="mutate-tv-row" data-field="[+field+]">
    <td class="mutate-tv-label">
        <span class="mutate-field-title" data-field-part="title">[+caption+]</span><br/>
        <span class="comment" data-field-part="help">[+description+]</span>
    </td>
    <td class="mutate-tv-value" data-field-part="value" style="[+zindex+]">
        [+FormElement+]
    </td>
</tr>
